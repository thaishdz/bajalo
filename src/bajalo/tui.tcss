Screen {
    align: center top;
}

#form {
    width: 100%;
    max-width: 90;
    padding: 1 2;
}

.group {
    height: auto;
    border: round $primary 70%;
    border-title-color: $accent;
    border-title-style: bold;
    padding: 0 1;
    margin-bottom: 1;
}

.row {
    height: auto;
}

.field {
    width: 1fr;
    height: auto;
}

.row .field {
    margin-right: 1;
}

.field Label {
    color: $text-muted;
    padding: 0 1;
}

#url_error {
    color: $error;
}

/* Path input under "Save to", shown only for "Other..." */
#custom_folder_box {
    display: none;
    height: auto;
    margin-right: 1;
}

#custom_folder_box Label {
    color: $text-muted;
    padding: 0 1;
}

#custom_folder_box #custom_folder_error {
    color: $error;
}

#download {
    width: 100%;
    margin-bottom: 1;
}

#progress {
    width: 100%;
}

#progress Bar {
    width: 1fr;
}

#progress_box {
    display: none;
}

#progress Bar > .bar--indeterminate {
    color: $primary;
}

#download_error {
    display: none;
    width: 100%;
    color: $error;
}

/* When a download fails: red box, no bar, error message instead */
#progress_box.failed {
    border: round $error;
    border-title-color: $error;
}

#progress_box.failed #progress {
    display: none;
}

#progress_box.failed #download_error {
    display: block;
}

/* When a download finishes: show where the file was saved */
#download_path {
    display: none;
    width: 100%;
    color: $text-muted;
}

#progress_box.done #download_path {
    display: block;
}

#download_path:hover {
    color: $accent;
}
